# Stockroom v2 - Root Environment Configuration
# This file is for reference; actual server config is in server/.env

# Server (configured in server/.env)
# PORT=3001
# NODE_ENV=development
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password_here
# DB_NAME=stockroom_v2
# DB_SSL=true # Required for the TiDB Cloud Starter public endpoint
# JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
# SESSION_COOKIE_NAME=stockroom_session
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAME_SITE=lax
# CLIENT_URL=http://localhost:5173